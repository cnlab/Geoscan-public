!pid %in% baseline_lost_contact$pid,
!pid %in% baseline_no_geodata$pid,
!pid %in% baseline_semantic_history$pid,
!pid %in% baseline_excluded$pid,
!pid %in% baseline_withdrew$pid,
!pid %in% s2_excluded$pid)
