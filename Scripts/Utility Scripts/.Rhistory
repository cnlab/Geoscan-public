# Function to compute EMA response rate summary for each dataframe
get_ema_summary <- function(df) {
df %>%
summarise(
ema_rate = paste0(round(mean(as.numeric(percent_responded), na.rm = TRUE), 1), " (", round(sd(as.numeric(percent_responded), na.rm = TRUE), 1), ")"),
)
}
# Function to create formatted statistics string
format_stats <- function(data, complete_data, value_col = "percent_responded") {
filtered_data <- data %>% filter(pid %in% complete_data$pid)
if (nrow(filtered_data) == 0) {
return("n/a")
}
sprintf("%.1f%% (%.1f%%) (n=%d)",
mean(filtered_data[[value_col]], na.rm = TRUE),
sd(filtered_data[[value_col]], na.rm = TRUE),
nrow(filtered_data))
}
# Create the data frame with your statistics
table_data <- tibble(
` ` = c("Tobacco retailer", "Nontobacco retailer", "Control"),
`Completed Baseline Period` = c(
format_stats(quality_metrics %>% filter(Type=="Baseline"), post),
format_stats(quality_metrics %>% filter(Type=="Baseline"), no_post),
format_stats(quality_metrics %>% filter(Type=="Baseline"), control)
),
`Completed Intervention Period` = c(
format_stats(quality_metrics %>% filter(Type=="Intervention"), post_complete),
format_stats(quality_metrics %>% filter(Type=="Intervention"), no_post_complete),
format_stats(quality_metrics %>% filter(Type=="Intervention"), control_complete)
),
`Completed Intervention Period with 20 Store Visits` = c(
format_stats(quality_metrics %>% filter(Type=="Intervention"), post_20_visits),
format_stats(quality_metrics %>% filter(Type=="Intervention"), no_post_store_visits),
"n/a"
)
)
